/* Shared ranking logic: no writes to Firebase or prompt data. */
function statsRows(pages, counts){
  const rows = [];
  const accountedKeys = new Set();

  Object.entries(pages).forEach(([route, page]) => {
    if(!page || page.redirect) return;
    (page.cuts || []).forEach(cut => {
      allCountKeys(page, cut).forEach(key => accountedKeys.add(key));
      const count = allCountKeys(page, cut).reduce((sum, key) =>
        sum + (typeof counts[key] === 'number' ? counts[key] : 0), 0);
      if(count <= 0) return;
      rows.push({id:countKey(page, cut), count, model:pageLabel(page), date:String(page.date),
        setNum:page.source_set || page.set, cutNum:cut.cut, route, title:cut.title});
    });
  });

  Object.keys(counts).filter(key => !accountedKeys.has(key)).forEach(key => {
    const value = counts[key];

    if(typeof value !== 'number' || value <= 0){
      return;
    }

    const parts = key.split('_');

    if(parts.length < 4){
      return;
    }

    const cutStr = parts[parts.length - 1];
    const setStr = parts[parts.length - 2];
    const date = parts[parts.length - 3];
    const model = parts.slice(0, parts.length - 3).join('_');

    const setNum = parseInt(setStr.replace('set', ''), 10);
    const cutNum = parseInt(cutStr.replace('cut', ''), 10);

    const route =
      `/${model}/${date}/set${String(setNum).padStart(2, '0')}`;

    let cutTitle = '(삭제되었거나 알 수 없는 컷)';

    const page = pages[route];

    if(page){
      const cut =
        (page.cuts || []).find(c => Number(c.cut) === cutNum);

      if(cut){
        cutTitle = cut.title;
      }
    }

    rows.push({
      id:key,
      count:value,
      model:model,
      date:date,
      setNum:setNum,
      cutNum:cutNum,
      route:route,
      title:cutTitle
    });
  });

  rows.sort((a, b) => b.count - a.count || a.id.localeCompare(b.id));
  rows.forEach((row, index) => {
    row.rank = index && rows[index - 1].count === row.count ? rows[index - 1].rank : index + 1;
  });
  return rows;

}
function statsDay(date = new Date()){
  return new Date(date.getTime() + 9 * 3600000).toISOString().slice(0, 10);
}
function statsBaseline(history, now = new Date()){
  const day = statsDay(new Date(now.getTime() - 86400000));
  const snapshot = history?.days?.[day];
  if(!snapshot || !validStatsCounts(snapshot.counts)) return null;
  const stamp = new Date(snapshot.at);
  if(!Number.isFinite(stamp.getTime()) || statsDay(stamp) !== day) return null;
  return snapshot;
}
function validStatsCounts(counts){
  return !!counts && typeof counts === 'object' && !Array.isArray(counts) &&
    Object.values(counts).every(n => Number.isSafeInteger(n) && n >= 0);
}
function statsChanges(rows, before){
  const previous = new Map(before.map(row => [row.id, row]));
  return rows.map(row => {
    const old = previous.get(row.id);
    return {...row, previous:old?.count || 0, delta:row.count - (old?.count || 0),
      oldRank:old?.rank ?? null, movement:old ? old.rank - row.rank : null};
  });
}
function statsMovement(row){
  if(row.oldRank === null) return 'NEW · 신규 진입';
  const shift = row.movement;
  return (shift > 0 ? `▲ ${shift} 상승` : shift < 0 ? `▼ ${-shift} 하락` : '— 유지') +
    ` · ${row.oldRank}위 → ${row.rank}위`;
}
async function fetchStatsJSON(url){
  const response = await fetch(url, {cache:'no-store', signal:AbortSignal.timeout(15000)});
  if(!response.ok) throw new Error('Statistics unavailable');
  return response.json();
}
